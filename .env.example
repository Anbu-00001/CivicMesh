# Required — NVIDIA NIM key used by byllm for the model chain in llm/stubs.jac
# (default primary: mistralai/mistral-nemotron).
# Get a free key at https://build.nvidia.com/.
NVIDIA_NIM_API_KEY=

# Optional — fallback provider used if NIM is unreachable. Leave blank to disable.
FEATHERLESS_API_KEY=

# Optional — server bindings. Defaults shown.
# JAC_SCALE_HOST=127.0.0.1
# JAC_SCALE_PORT=8001
# JAC_CLIENT_PORT=8000

# Optional — log verbosity: debug | info | warn | error.
# CIVICMESH_LOG_LEVEL=info

# Optional — override the LLM fallback chain (comma-separated litellm ids, tried in order).
# Use this when NVIDIA retires a model: no code change, just update the Space variable.
# CIVICMESH_LLM_MODELS=nvidia_nim/mistralai/mistral-nemotron,nvidia_nim/openai/gpt-oss-20b
